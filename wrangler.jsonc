{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apphero",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Le Worker passe devant les pages, l'API, les apps (sortie à 18 h) et les liens courts /05.
    // Les fichiers du site lui-même (scripts, styles, polices, images, vidéos) sont servis directement :
    // ils ne dévoilent rien et ne comptent pas dans le quota de requêtes du Worker.
    "run_worker_first": ["/*", "!/assets/*", "!/plateau/*", "!/media/*", "!/icon-192.png", "!/icon-512.png", "!/favicon.svg", "!/og.jpg", "!/t.js", "!/fiche.js", "!/manifest.webmanifest"]
  },
  // Le domaine du défi. www redirige vers le domaine nu (voir worker/src/index.js).
  "routes": [
    { "pattern": "apphero.cloud", "custom_domain": true },
    { "pattern": "www.apphero.cloud", "custom_domain": true }
  ],
  // Le site ne répond que sur son domaine.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apphero",
      "database_id": "8037a815-35f7-472c-8d82-e0af8ca07a8c"
    }
  ],
  "vars": {
    // Clé publique Turnstile (laisser vide pour désactiver la vérification).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGDo-CG3-tcnXKDz",
    "REPO_URL": "https://github.com/Naod6473/AppHero"
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put) : ADMIN_TOKEN, IP_SALT, TURNSTILE_SECRET.
}
